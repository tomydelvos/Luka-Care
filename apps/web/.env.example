# Salin ke .env.development.local untuk override lokal.
# Semua variabel VITE_* ikut ter-bundle ke browser — JANGAN taruh secret di sini.

# Nama environment yang tampil di badge pojok (development | staging | production)
VITE_APP_ENV=development

# Alamat API Worker
VITE_API_URL=http://localhost:8787

# true  = data disimpan di browser (localStorage), belum perlu backend
# false = semua data lewat VITE_API_URL
VITE_USE_MOCK_API=true

# history (default, untuk domain sendiri) | hash (hosting tanpa SPA fallback) | memory (pratinjau di iframe)
VITE_ROUTER_MODE=history
